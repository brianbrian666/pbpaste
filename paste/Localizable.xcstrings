            "value": "稍后"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机自启"
          }
        }
      }
    },
    "No clipboard history yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有剪贴板历史"
          }
        }
      }
    },
    "No items in this time range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该时间段内没有项目"
          }
        }
      }
    },
    "No matches": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配项"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "Paste as Plain Text": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴为纯文本"
          }
        }
      }
    },
    "Pasting directly needs Accessibility access. Grant it in System Settings > Privacy & Security > Accessibility; until then, items are only copied to the clipboard.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接粘贴需要辅助功能权限。请在「系统设置 > 隐私与安全性 > 辅助功能」中授权；授权前项目只会复制到剪贴板。"
          }
        }
      }
    },
    "Pause Monitoring": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停监听"
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定"
          }
        }
      }
    },
    "Pinned items are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定项会保留。"
          }
        }
      }
    },
    "Press keys…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下组合键…"
          }
        }
      }
    },
    "Quit pbpaste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 pbpaste"
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启"
          }
        }
      }
    },
    "Restart Required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重启"
          }
        }
      }
    },
    "Search clipboard history": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索剪贴板历史"
