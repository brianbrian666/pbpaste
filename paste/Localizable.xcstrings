      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空历史"
          }
        }
      }
    },
    "Clear clipboard history?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空剪贴板历史？"
          }
