    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "Unpin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消固定"
          }
        }
      }
    },
    "iCloud storage is unavailable in this build (missing iCloud entitlement). History is stored on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建无法使用 iCloud 存储（缺少 iCloud 权限），历史记录将保存在本机。"
          }
        }
      }
    },
    "pbpaste Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pbpaste 设置"
          }
        }
      }
    },
