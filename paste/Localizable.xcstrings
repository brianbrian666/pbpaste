      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "Shortcut needs ⌘, ⌃, ⌥, or a function key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键需包含 ⌘、⌃、⌥ 或使用功能键。"
          }
        }
      }
    },
    "Show Clipboard History": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示剪贴板历史"
          }
        }
      }
    },
    "Show History Hotkey": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示历史快捷键"
          }
        }
      }
    },
