    "History is stored in iCloud Drive. Changing this setting requires restarting the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录将存入 iCloud 云盘。切换此设置需要重启应用。"
          }
        }
      }
    },
