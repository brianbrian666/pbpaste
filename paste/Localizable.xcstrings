      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "←→ 选择"
          }
        }
      }
    },
    "↩ Paste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ 粘贴"
          }
        }
      }
